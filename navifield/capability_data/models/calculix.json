          "small"
        ],
        "thermal_feedback": [
          "one_way"
        ]
      },
      "inputs": [
        {
          "key": "elastic_modulus",
          "meaning": "弹性模量，单位 Pa 或一致单位制的应力单位。"
        },
        {
          "key": "poisson_ratio",
