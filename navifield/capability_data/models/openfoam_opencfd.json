    {
      "id": "buoyantBoussinesqSimpleFoam",
      "label": "稳态 Boussinesq 小密度变化自然对流",
      "capability_ids": [
        "openfoam_opencfd.steady_boussinesq_convection"
      ],
      "mechanisms": [
        "conduction",
        "fluid_advection",
        "buoyancy"
      ],
      "goals": [
        "temperature",
        "heat_flux",
        "wall_heat_flux"
      ],
      "conditions": {
        "geometry": [
          "fluid",
          "enclosure"
        ],
        "motion": [
          "buoyant"
        ],
        "density": [
          "small_variation"
        ],
        "time": [
          "steady"
        ]
      },
      "inputs": [
        {
          "key": "density",
          "meaning": "参考或固体密度 [kg/m³]。"
        },
        {
          "key": "fluid_properties",
          "meaning": "流体热物性，至少提供黏度 [Pa·s] 或运动黏度 [m²/s]、导热率 [W/(m·K)] 和比热 [J/(kg·K)]，或相应扩散系数。"
        },
        {
          "key": "flow_bc",
          "meaning": "速度 [m/s]、压力（物理压力 Pa 或求解器运动学压力 m²/s²）、流量及闭腔参考信息。"
        },
        {
          "key": "thermal_bc",
          "meaning": "温度 [K]、热流密度 [W/m²]、绝热等热边界，按 patch 定义。"
        },
        {
          "key": "gravity",
          "meaning": "重力加速度矢量 [m/s²]。"
        },
        {
          "key": "expansion_coefficient",
          "meaning": "体膨胀系数 β [K⁻¹]。"
        },
        {
          "key": "reference_temperature",
          "meaning": "线性化或物性评估参考温度 [K]。"
        }
      ],
      "outputs": [
        "温度、速度与压力场",
        "壁热流密度 [W/m²]；按指定参考温差与长度推算 Nu"
      ],
      "assumptions": [
        "相对密度变化远小于 1，使用 |β(T−T_ref)|≪1 检查；密度线性变化仅进入浮力。",
        "Ra=gβ|ΔT|L³/(να)；L 对方腔取腔高。高 Ra 时评估是否需要湍流或非定常求解。"
      ],
      "limitations": [
        "基准只校验指定几何和参数。边界热流精度依赖近壁网格、湍流方案、边界与物性。",
        "强温差或相变、组分变化超出闭合时应换模型。"
      ],
      "couplings": [
        {
          "from_field": "temperature",
          "to_field": "momentum",
          "quantity": "重力相关浮力项",
          "transfer": "rhok=1−β(T−T_ref)",
          "custom_work": "提供重力、物性及温度或压力参考。"
        },
        {
          "from_field": "velocity",
          "to_field": "temperature",
          "quantity": "对流能量输运",
          "transfer": "流场求解与温度/能量方程迭代",
          "custom_work": "用壁热流或 Nu、质量和能量收支检查。"
        }
      ],
      "basis": "小密度变化、浮力驱动、其余物性可在参考态近似时使用。",
      "evidence": [
        {
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/heatTransfer/buoyantBoussinesqSimpleFoam/buoyantBoussinesqSimpleFoam.C",
          "locator": "applications/solvers/heatTransfer/buoyantBoussinesqSimpleFoam/buoyantBoussinesqSimpleFoam.C；Description；同目录 TEqn.H/rhok（Boussinesq）或 createFields.H/rhoThermo（变密度）",
          "claim": "本版对应时间推进与热浮力路径。"
        },
        {
          "kind": "family_reference",
          "url": "https://onlinelibrary.wiley.com/doi/10.1002/fld.1650030305",
          "locator": "de Vahl Davis 1983，差温方腔，表 V",
          "claim": "二维 Boussinesq、空气 Pr≈0.71，Ra=10³、10⁴、10⁵、10⁶ 的网格外推数值基准，对比平均 Nu 和速度。覆盖范围仅限该数值基准。"
        },
        {
          "kind": "upstream_case",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/tutorials/heatTransfer/buoyantBoussinesqSimpleFoam/hotRoom",
          "locator": "tutorials/heatTransfer/buoyantBoussinesqSimpleFoam/hotRoom",
          "claim": "本版上游设置示例，未在本次复算。"
        }
      ]
    },
