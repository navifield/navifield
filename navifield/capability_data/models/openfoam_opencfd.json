{
  "solver": "openfoam_opencfd",
  "version": "v2606",
  "domain": "heat_transfer",
  "models": [
    {
      "id": "laplacianFoam",
      "label": "固体热扩散 laplacianFoam",
      "capability_ids": [],
      "mechanisms": [
        "conduction"
      ],
      "goals": [
        "temperature",
        "heat_flux",
        "wall_heat_flux"
      ],
      "conditions": {
        "geometry": [
          "solid"
        ],
        "motion": [
          "none"
        ],
        "time": [
          "steady",
          "transient"
        ]
      },
      "inputs": [
        {
          "key": "conductivity",
          "meaning": "热导率 k [W/(m·K)]，用于物理热流换算。"
        },
        {
          "key": "thermal_bc",
          "meaning": "温度边界 [K] 或相容梯度 [K/m]；物理热流边界用 k 换算。"
        },
        {
          "key": "thermal_diffusivity",
          "derived_from": [
            "conductivity",
            "density",
            "heat_capacity"
          ],
          "meaning": "瞬态扩散系数 DT [m²/s]，可直接给出或用 k/(ρc_p) 换算。",
          "when": {
            "time": [
              "transient"
            ]
          }
        },
        {
          "key": "initial_temperature",
          "meaning": "瞬态初始温度场 [K]。",
          "when": {
            "time": [
              "transient"
            ]
          }
        }
      ],
      "outputs": [
        "温度 T [K]",
        "由几何法向温度梯度和热导率计算 qₙ [W/m²]"
      ],
      "assumptions": [
        "单计算域求单标量 T。DT 可读为 0/DT 标量场，或由 constant/transportProperties 给统一常数。",
        "稳态非零常 DT 的纯温度边值问题只需温度边界，DT 的具体数值不改变解。热流回读取 k；瞬态可直接给 DT，仅由物性换算时才同时需要 k、ρ 和 c_p。"
      ],
      "limitations": [
        "单标量扩散的温度方程不是多材料能量守恒入口。将各材料的 k/(ρc_p) 直接映到同一 DT 场，可能得到不守恒的界面物理热流；材料差异显著时须显式处理能量方程与接口。"
      ],
      "couplings": [
        {
          "from_field": "solid_temperature",
          "to_field": "wall_heat_flux",
          "quantity": "法向热流密度 [W/m²]",
          "transfer": "按 −k∂T/∂n 后处理",
          "custom_work": "指定导热率和向外法向、积分目标面。"
        }
      ],
      "basis": "仅固体内的传热由温度梯度驱动时，基础热扩散即可。用一维平板解析解核对稳态温度和热流，用瞬态温升曲线核对热容量。",
      "evidence": [
        {
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/basic/laplacianFoam/laplacianFoam.C",
          "locator": "applications/solvers/basic/laplacianFoam/laplacianFoam.C；33–52，温度方程",
          "claim": "发布源码列出 ∂T/∂t=∇·(D_T∇T)，适用于固体热扩散。"
        },
        {
          "kind": "upstream_case",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/tutorials/basic/laplacianFoam/flange",
          "locator": "tutorials/basic/laplacianFoam/flange",
          "claim": "上游法兰热扩散设置示例，非对实测精度的承诺。"
        },
        {
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/basic/laplacianFoam/createFields.H",
          "locator": "applications/solvers/basic/laplacianFoam/createFields.H；17–46",
          "claim": "优先读 DT 标量场；否则从 transportProperties 读统一常数 DT。应用不读取各区域 k、ρ 或 c_p。"
        }
      ]
    },
    {
      "id": "chtMultiRegionSimpleFoam",
      "label": "稳态多区域共轭传热",
      "capability_ids": [
        "openfoam_opencfd.steady_cht",
        "openfoam_opencfd.mapped_baffle_thermal_layers",
        "openfoam_opencfd.wall_heat_flux_readback"
      ],
      "mechanisms": [
        "conduction",
        "fluid_advection"
      ],
      "goals": [
        "temperature",
        "heat_flux",
        "interface_temperature",
        "wall_heat_flux"
      ],
      "conditions": {
        "geometry": [
          "fluid_solid"
        ],
        "motion": [
          "forced",
          "buoyant"
        ],
        "time": [
          "steady"
        ]
      },
      "inputs": [
        {
          "key": "conductivity",
          "meaning": "固体热导率 k [W/(m·K)]，可按各区域给出。"
        },
        {
          "key": "density",
          "meaning": "参考或固体密度 [kg/m³]。"
        },
        {
          "key": "heat_capacity",
          "meaning": "等压比热 [J/(kg·K)]。"
        },
        {
          "key": "thermal_bc",
          "meaning": "温度 [K]、热流密度 [W/m²]、绝热等热边界，按 patch 定义。"
        },
        {
          "key": "fluid_properties",
          "meaning": "流体热物性，至少提供黏度 [Pa·s] 或运动黏度 [m²/s]、导热率 [W/(m·K)] 和比热 [J/(kg·K)]，或相应扩散系数。"
        },
        {
          "key": "flow_bc",
          "meaning": "速度 [m/s]、压力（物理压力 Pa 或求解器运动学压力 m²/s²）、流量及闭腔参考信息。"
        },
        {
          "key": "interface_mapping",
          "meaning": "流固配对区域及 patch 映射，可附薄层厚度 [m] 与热导率 [W/(m·K)]。"
        },
        {
          "key": "gravity",
          "meaning": "浮力显著时给重力加速度矢量 [m/s²]。",
          "when": {
            "motion": [
              "buoyant"
            ]
          }
        }
      ],
      "outputs": [
        "各流体与固体区域温度 [K]",
        "界面两侧壁温 [K]、法向热流密度 [W/m²] 及界面净热流 [W]"
      ],
      "assumptions": [
        "完美接触界面两侧壁温连续、法向热流等值反向；显式薄层热阻允许温差。",
        "选多区域传热时检查区域数、流固配对、近壁网格、能量收支。浮力显著时另补重力和有效密度模型。"
      ],
      "limitations": [
        "仅有固定壁温或换热系数时可用单域边界；需要流固温度和热流相互反馈才用此多区域求解。",
        "上游案例证明设置路径，交付精度需按接口守恒及测量或参考模型复核。"
      ],
      "couplings": [
        {
          "from_field": "fluid_temperature",
          "to_field": "solid_temperature",
          "quantity": "界面热流密度 [W/m²] 与邻区温度 [K]",
          "transfer": "配对 mapped 界面双侧热传递",
          "custom_work": "生成配对 patch，检查两侧法向、映射守恒及可选热阻。"
        },
        {
          "from_field": "solid_temperature",
          "to_field": "fluid_temperature",
          "quantity": "反向热流密度 [W/m²] 与邻区温度 [K]",
          "transfer": "同一耦合边界反向反馈",
          "custom_work": "检查界面通量守恒和全域能量闭合。"
        }
      ],
      "basis": "流体对流与固体导热共同决定界面温度和热流。适合寻找定常稳定热平衡。",
      "evidence": [
        {
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/heatTransfer/chtMultiRegionFoam/chtMultiRegionSimpleFoam/chtMultiRegionSimpleFoam.C",
          "locator": "applications/solvers/heatTransfer/chtMultiRegionFoam/chtMultiRegionSimpleFoam/chtMultiRegionSimpleFoam.C；33–38；同目录 fluid/EEqn.H、solid/solveSolid.H",
          "claim": "本版联立流体能量与固体导热。"
        },
        {
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/src/thermoTools/derivedFvPatchFields/turbulentTemperatureCoupledBaffleMixed/turbulentTemperatureCoupledBaffleMixedFvPatchScalarField.H",
          "locator": "src/thermoTools/derivedFvPatchFields/turbulentTemperatureCoupledBaffleMixed/turbulentTemperatureCoupledBaffleMixedFvPatchScalarField.H；31–56",
          "claim": "支持邻区温度、按 kδ 配重和可选薄层热阻。"
        },
        {
          "kind": "upstream_case",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/tutorials/heatTransfer/chtMultiRegionSimpleFoam/cpuCabinet",
          "locator": "tutorials/heatTransfer/chtMultiRegionSimpleFoam/cpuCabinet",
          "claim": "原包上游配对设置例；未将教程当成量化精度验证。"
        }
      ]
    },
