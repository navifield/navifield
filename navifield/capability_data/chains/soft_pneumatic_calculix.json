{
  "solver": "calculix",
  "version": "2.22",
  "chains": [
    {
      "id": "soft_pneumatic_static_actuator",
      "status": "custom",
      "scope": "给定腔内净压差的准静态有限变形候选；求自由端角度与受阻反力须分开约束和求解。压力作为输入时不求未知气压或流场、无双向气固耦合。任意用户几何还需建模、网格及结果核验。",
      "steps": [
        {
          "id": "material",
          "operation": "转换并核验可压缩超弹材料",
          "equation": "CCX 的 U=C10(Ī1−3)+(J−1)²/D1。仅在线性各向同性初始切线意义：G=E/[2(1+ν)]，K=E/[3(1−2ν)]，C10=G/2，D1=2/K，0<ν<0.5 时保持有限 K；C10 为应力、D1 为应力倒数。",
          "receives": [
            "E、ν 或独立拟合的 C10、D1，材料试验、密度与单位"
          ],
          "produces": [
            "经核验的超弹模型和材料域"
          ],
          "implementation": "custom",
          "evidence": [
            "material"
          ],
          "depends_on": []
        },
        {
          "id": "pressure",
          "operation": "核对受压面并施加载荷",
          "equation": "取 Δp=p_in−p_out 并保留符号。用 NLGEOM 随动面压力，在真实受压面按当前固体外法向 n 施加牵引 t=−p n。若采用净压等效，核对内外压暴露范围和约束，证实等效压力的加载面、方向及合力。",
          "receives": [
            "各腔压差或各侧压力 Pa、带实体几何面的腔壁/端盖及外露面标识、加载序列"
          ],
          "produces": [
            "按面号装配的随动压力及参照"
          ],
          "implementation": "custom",
          "evidence": [
            "pressure"
          ],
          "depends_on": []
        },
        {
          "id": "free_solid",
          "operation": "计算自由端的非线性固体平衡",
          "equation": "*STEP, NLGEOM 配合 *STATIC，受压和重力分增量求平衡；夹紧实际固定端、自由端不施加止挡；检查可能的自接触或失稳。",
          "receives": [
            "材料模型、实体单元和压力载荷、夹持与重力"
          ],
          "produces": [
            "位移场 m、端面变形和应力 Pa"
          ],
          "implementation": "custom",
          "evidence": [
            "material",
            "pressure"
          ],
          "depends_on": [
            "material",
            "pressure"
          ]
        },
        {
          "id": "angle",
          "operation": "从变形后标记或端面提取有符号自由角",
          "equation": "在约定弯曲平面把变形端方向投影，按 atan2 计算相对固定参考轴的角；对照无压基准时扣除安装或重力零偏。空间变形须报告角度定义及扭转影响。",
          "receives": [
            "节点位移 m、端盖标记和参考轴、零压测角定义"
          ],
          "produces": [
            "自由弯曲角 deg"
          ],
          "implementation": "custom",
          "evidence": [
            "pressure"
          ],
          "depends_on": [
            "free_solid"
          ]
        },
        {
          "id": "blocked_force",
          "operation": "在独立止挡边界求解并读反力",
          "equation": "改用指定止挡位置和接触/受阻自由度重新计算，再按测力轴投影合反力；去除直接外载的贡献并核对总平衡。自由端角度与夹具根部反力不可替代堵转测力。",
          "receives": [
            "材料模型、腔压、夹持和止挡几何/接触及测力轴"
          ],
          "produces": [
            "堵转测力分量 N"
          ],
          "implementation": "custom",
          "evidence": [
            "material",
            "pressure"
          ],
          "depends_on": [
            "material",
            "pressure"
          ]
        }
      ],
      "closures": [
        {
          "name": "近不可压有限体积模量",
          "relation": "CCX 2.22 没有用于此材料的完全不可压混合单元；不要用 D1=0 代替材料。比较适宜网格/积分方案，如可网格化时 C3D20R 与 C3D10 的结果敏感性，检查体积变化、锁死、小时玻璃/零能模态及畸变。",
          "applicability": "近不可压，材料变形范围内",
          "implementation": "custom",
          "evidence": [
            "material"
          ]
        },
        {
          "name": "受控内压适用条件",
          "relation": "设定的均匀压力或已知载荷分布不随固体体积反求；若供压动态、封闭气体状态或流量改变压力，则需额外的气体状态或气固双向模型。",
          "applicability": "压力可视作外部给定且达稳态的工况",
          "implementation": "custom",
          "evidence": [
            "pressure"
          ]
        }
      ],
      "required_inputs": [],
      "custom_work": [
        "建立气侧面到 CCX 单元面编号及法向的可核映射，建模实际材料域、检验夹具和压力符号，实测网格/增量收敛。",
        "编写或配置自由端角和止挡测力读回，分别校验测角零点与测力方向；没有默认原生模板。"
      ],
      "checks": [
        "低压小增量先核对补丁载荷方向和压力合力；检查各阶段反力平衡及单元 Jacobian。",
        "使用受控的对网格、体积模量和增量敏感性，并用独立的压力—角度实验验证自由边界，独立止挡试验验证力。"
      ],
