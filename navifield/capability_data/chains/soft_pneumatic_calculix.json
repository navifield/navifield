    {
      "id": "soft_pneumatic_transient_gas_structure",
      "status": "custom",
      "scope": "阀前压力给定、腔内压力随变容而变时的双向瞬态候选。CalculiX 2.22 仅作为结构组件；阀与气腔模型、迭代交换和轨迹读回均待自研与验证。",
      "steps": [
        {
          "id": "chamber_pressure",
          "operation": "求阀控充气腔的压力时序",
          "equation": "腔内近均匀时求 dm/dt=ṁin−ṁout，p_abs V=mRT；非等温时加入能量收支（流股焓、换热及 −p_abs·dV/dt）。由独立量测 V(t)、经验证的定容近似或变容模型闭合；计入软管阻力及适用时的波传播和储气。",
          "receives": [
            "阀前压力温度、阀与软管的瞬态质量流量特性、腔体初始状态、V(t) 或经验证的容积模型"
          ],
          "produces": [
            "指定腔室的压力时序 Pa；换算表压时扣除参考压力"
          ],
          "implementation": "custom",
          "evidence": [
            "ideal_gas"
          ],
          "depends_on": []
        },
        {
          "id": "gas_structure_transient",
          "operation": "按时间耦合阀流、可压缩气腔和瞬态结构",
          "equation": "气腔压力空间近均匀时求 dm/dt=ṁin−ṁout，p_abs V=mRT；非等温时同步解内能收支（流股焓、边界功 −p_abs·dV/dt、换热）。将 p_abs−p_ambient 映射给当前内壁，结构返回更新体积 V(t) 与 dV/dt；有压力波或局部流动时需升级为分布式求解。",
          "receives": [
            "阀特性、上游总状态/回压、气腔初始 m/T/V、结构初态和动态材料/边界"
          ],
          "produces": [
            "腔压 Pa、容积 m³、结构位移和速度随时间的场"
          ],
          "implementation": "custom",
          "evidence": [
            "ccx"
          ],
          "depends_on": []
        },
        {
          "id": "trajectory",
          "operation": "读回指定端部标记轨迹",
          "equation": "x(t)=X+u(t)；按用户坐标系、动作开始和采样间隔输出，校核压力与位移时间同步。",
          "receives": [
            "时序位移、端部标记与坐标系"
          ],
          "produces": [
            "端部轨迹 m/t"
          ],
          "implementation": "custom",
          "evidence": [
            "ccx"
          ],
          "depends_on": [
            "gas_structure_transient"
          ]
        }
      ],
      "closures": [
        {
          "name": "气腔与结构双向交换",
          "relation": "结构一侧用带惯性的有限变形动力学，控制耦合时间步并对压力与容积迭代；阀前供压只用于阀流模型，不能直接施加到结构。",
          "applicability": "需确认气腔近均匀、材料速率效应及耦合收敛",
          "implementation": "custom",
          "evidence": [
            "ccx"
          ]
        }
      ],
