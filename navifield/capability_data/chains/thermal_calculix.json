  "solver": "calculix",
  "version": "2.22",
  "chains": [
    {
      "id": "internally_heated_solid_conduction",
      "scope": "CalculiX 2.22 稳态导热选型候选，适合净固体发热已知而边界需要独立辨识。薄层降阶须守恒，并检查与峰值量的相容性。",
      "status": "custom",
      "steps": [
        {
          "id": "solid_source",
          "operation": "在实际发热体上定义净热源",
          "equation": "P=∫q'''dV；均匀薄层 q'''=P/(Aδ)，如降阶以 P/A 作为一次等效面输入，避免给两侧各施加一次总热。",
          "receives": [
            "发热功率或热源分布、热源体积和单位"
          ],
          "produces": [
            "限定区域的体积热源或单次等效面热源"
          ],
          "implementation": "custom",
          "evidence": [
            "heat_cards",
            "heat_assembly"
          ],
          "depends_on": []
        },
        {
          "id": "conduction",
          "operation": "解方向相关导热和固体接触",
          "equation": "−∇·(K∇T)=q'''。旋转材料主轴 K=R diag(k₁,k₂,k₃) Rᵀ；有限界面热阻的温降 q_n R''，外部冷却依真实边界。",
          "receives": [
            "固体材料与方向、接口、双侧冷却和热源"
          ],
          "produces": [
            "固体温度与界面热流"
          ],
          "implementation": "custom",
          "evidence": [
            "heat_cards"
          ],
          "depends_on": [
            "solid_source"
          ]
        },
        {
          "id": "readback",
          "operation": "读取固体温度和指定热量",
          "equation": "指定温度取值的区域、侧别、基准和时间；峰值报告位置，固定温面用热反力并核对总功率。",
          "receives": [
            "材料/接触域、测点定义"
          ],
          "produces": [
            "温度、峰温位置或温差"
          ],
          "implementation": "custom",
          "evidence": [
            "heat_cards"
          ],
          "depends_on": [
            "conduction"
          ]
        }
      ],
      "closures": [
        {
          "name": "热边界可辨识性",
          "relation": "已知内热源仍需至少一个有效散热路径和相应温度或传热条件；无散热闭合不能确定稳态温度。",
          "applicability": "通风需要独立风道边界或多区域解。",
          "implementation": "custom",
          "evidence": [
            "heat_cards"
          ]
        }
      ],
      "required_inputs": [],
      "custom_work": [
        "按实际工况建立区域、系数、边界、守恒验证和观测回读。"
      ],
      "checks": [
        "核对正确发热域的积分功率、材料轴、固固热流守恒、外边界的散热功率及目标温度对网格的敏感性。",
        "RFL 阶段需扣除固定节点分摊的直接体积热源再按外向热量汇总。直接低阶 HFL 面迹积分偏低：厚板粗/细每面 7/7.5 W 对 8 W，旋转粗/细每面 0.0435/0.04725 W 对 0.051 W。均是固定温面的稳态子问题，未验证界面热阻、膜系数、辐射、风道或 Wang 全包。"
      ],
      "sources": [
