    {
      "id": "moving_solid_surface_heating",
      "scope": "CalculiX 2.22 材料坐标下的过段瞬态导热。恒速、固定加热区可用材料随动时间；如需设备全场和非均匀进料则另设欧拉对流或随动模型。",
      "status": "custom",
      "steps": [
        {
          "id": "exposure",
          "operation": "转换加热区为材料曝光时序",
          "equation": "恒速通过 τ=L/U；吸收面热通量 q'' 对应 D=∫q''dt。若均匀，D=q''τ；只有已知吸收深度和分布才能改作内部体积源项。",
          "receives": [
            "加热段长度、线速、吸收面与吸收热流分布"
          ],
          "produces": [
            "曝光时间、表面施加时序与剂量"
          ],
          "implementation": "custom",
          "evidence": [
            "flux_cards"
          ],
          "depends_on": []
        },
        {
          "id": "transient_solid",
          "operation": "解材料坐标下厚向瞬态",
          "equation": "ρcp∂T/∂t=∇·(K∇T)，按位置转时间施加正面热流和两面冷却。仅当厚向热扩散及换热尺度支持时可用集中模型。",
          "receives": [
            "时间热边界、入口温度、厚度和热物性"
          ],
          "produces": [
            "厚向温度随时间分布"
          ],
          "implementation": "custom",
          "evidence": [
            "flux_cards"
          ],
          "depends_on": [
            "exposure"
          ]
        },
        {
          "id": "readback",
          "operation": "读取离开热区的背面温度",
          "equation": "取材料时间 τ 对应的出口，背表面 T(z=h,τ)，可同时计算相同时间前后面温差。",
          "receives": [
            "背面与出口时刻、取样定义"
          ],
          "produces": [
            "出口背温或指定温差"
          ],
          "implementation": "custom",
          "evidence": [
            "flux_cards"
          ],
          "depends_on": [
            "transient_solid"
          ]
        }
      ],
      "closures": [
        {
          "name": "吸收量与湿态边界",
          "relation": "给定净吸收通量时不反推光学吸收率；只有实际存在液体或相变化才需汽化或组分传输。",
          "applicability": "适用干燥固体的已知表面热源。",
          "implementation": "custom",
          "evidence": [
            "flux_cards"
          ]
        }
      ],
      "required_inputs": [],
      "custom_work": [
        "按实际工况建立区域、系数、边界、守恒验证和观测回读。"
      ],
      "checks": [
        "比较曝光量与热收支，检查厚向温度梯度和网格/时间步敏感性；输入不足时不给唯一出口温度。"
      ],
      "sources": [
