        },
        {
          "id": "flow_rate_2606",
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/raw/OpenFOAM-v2606/src/finiteVolume/fields/fvPatchFields/derived/flowRateInletVelocity/flowRateInletVelocityFvPatchVectorField.H",
          "locator": "v2606 flowRateInletVelocity, Description/Usage",
          "claim": "体积流量输入为 m³/s，质量输入为 kg/s，入口正向；核对密度与速度入口剖面。"
        },
        {
          "id": "surface_2606",
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/raw/OpenFOAM-v2606/src/functionObjects/field/fieldValues/surfaceFieldValue/surfaceFieldValue.H",
          "locator": "v2606 surfaceFieldValue, patch/faceZone and operation table",
          "claim": "记录 areaAverage、weightedAverage、weightedAreaAverage 和绝对权重选项；面流量可用 sum 聚合。"
        },
        {
          "id": "porous_baffle_2606",
          "kind": "version_source",
          "url": "https://gitlab.com/openfoam/core/openfoam/-/raw/OpenFOAM-v2606/src/TurbulenceModels/turbulenceModels/derivedFvPatchFields/porousBafflePressure/porousBafflePressureFvPatchField.H",
          "locator": "OpenCFD v2606 porousBafflePressure, Description and Usage",
          "claim": "基于 cyclic 的薄层压力跳跃，输入 D、I 和流向厚度；其跳跃量和两测站总压差为不同观测。"
        }
      ],
