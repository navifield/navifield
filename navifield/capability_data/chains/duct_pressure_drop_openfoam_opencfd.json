{
  "solver": "openfoam_opencfd",
  "version": "v2606",
  "chains": [
    {
      "id": "forced_duct_pressure_drop",
      "status": "configured",
      "scope": "复用 OpenCFD v2606 simpleFoam 的 pressure_drop 目标能力。给定定常流量、风机或泵只作域外送流、刚性单相内流与低速近不可压；病例配置和测站读回须本地确认，泵/风机自身性能需独立路线。",
      "required_inputs": [],
      "steps": [
        {
          "id": "fixed_flow_boundary",
          "operation": "按给定流量配置入口和匹配的下游边界",
          "equation": "Q=∫u·n_in dA；ṁ=∫ρu·n_in dA。指定入口流量及下游参考静压，质量流量须一致密度。",
          "receives": [
            "实流量 [m³/s] 或质量 [kg/s]、管段网格与 wall、入口流向、流体状态与下游边界"
          ],
          "produces": [
            "v2606 flowRateInletVelocity 体积或质量约束、出口压力基准"
          ],
          "depends_on": [],
          "implementation": "configured",
          "evidence": [
            "flow_rate_2606",
            "simple_2606"
          ],
          "ports": {
            "inputs": [
              "flow_rate",
              "duct_geometry",
              "fluid_state",
              "outlet_boundary"
            ],
            "outputs": [
              "flow_boundary_conditions"
            ]
          }
        },
        {
          "id": "steady_internal_flow",
          "operation": "OpenCFD v2606 simpleFoam 稳态不可压求解",
          "equation": "∇·U=0，动量/压力由 SIMPLE 耦合，按流态使用层流或适当 RANS。",
          "receives": [
            "固定流量与下游/壁面边界、黏度/密度、网格和流态"
          ],
          "produces": [
            "速度 U [m/s]、运动学压力 p [m²/s²]、面流量 φ [m³/s]"
          ],
          "depends_on": [
            "fixed_flow_boundary"
          ],
          "implementation": "configured",
          "evidence": [
            "simple_2606"
          ],
          "ports": {
            "inputs": [
              "flow_boundary_conditions"
            ],
            "outputs": [
              "pressure",
              "velocity",
              "face_flux"
            ]
          }
        },
        {
          "id": "map_stations",
          "operation": "核对上/下游取压选区及原生压力计量",
          "equation": "simpleFoam p_phys=ρ p_kin [Pa]（同一参考基准）；p₀=p_phys+½ρ|U|²，对每面先构造总压再按约定加权。 壁面静压孔按实际孔/点局部取样，不以截面均值代替。",
          "receives": [
            "当前流场的 p/量纲、密度与必要的 U；两个面/点、权重与正方向"
          ],
          "produces": [
            "按同口径得到的上/下游压力 [Pa] 与带符号面通量"
          ],
          "depends_on": [
            "steady_internal_flow"
          ],
          "implementation": "configured",
          "evidence": [
            "simple_2606",
            "surface_2606"
          ],
          "ports": {
            "inputs": [
              "pressure",
              "velocity",
              "pressure_stations"
            ],
            "outputs": [
              "station_pressures",
              "station_flux"
            ]
          }
        },
        {
          "id": "ordered_delta_p",
          "operation": "报告有符号的压差及取压条件",
          "equation": "Δp=⟨p⟩_up−⟨p⟩_down；总压同理；有标高差按能量式明确静水项，整段压损与局部出口表压分列。 扩压段静压回升并不等于总压上升；分列两者。",
          "receives": [
            "上游和下游采用同一个静压/总压口径的读数与边界基准"
          ],
          "produces": [
            "气路压差 [Pa]、两站面和单位、正向及平均定义"
          ],
          "depends_on": [
            "map_stations"
          ],
          "implementation": "configured",
          "evidence": [
            "surface_2606"
          ],
          "ports": {
            "inputs": [
              "station_pressures"
            ],
            "outputs": [
              "pressure_drop"
            ]
          }
        }
      ],
      "closures": [
        {
          "name": "测站加权和基准",
          "relation": "面积权重、单点/取压孔或有符号/绝对通量权重依实验定义选用；核对回流面及面积已计入的面通量避免重复乘面积。",
          "applicability": "测压口与计算选区同几何，同工况、同基准及同压差定义；局部 recirculation 或可压缩场不可直接套用常密度公式。",
          "implementation": "configured",
          "evidence": [
            "surface_2606",
            "simple_2606"
          ]
        }
      ],
      "custom_work": [
        "本地生成/检查流道网格与边界、测站及采样权重；复用 pressure_drop 选型与原生测站后处理，用户尚未确认之前不启动求解。",
        "若启用薄阻力片，按 v2606 porousBafflePressure 的 cyclic 面和 D/I/length 核验局部静压跳跃，单独读整个流道的测站总压损失；禁止以猜测的滤芯曲线代入。"
      ],
      "checks": [
        "核对同一质量/体积口径的入口出口守恒、测面法向与回流、压力单位，做网格和测站敏感性检查；规整管段可用 Darcy–Weisbach 核对。"
      ],
      "sources": [
