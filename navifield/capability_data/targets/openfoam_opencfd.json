  {
    "solver": "openfoam_opencfd",
    "version": "v2606",
    "target": "wall_temperature",
    "role": "configured",
    "model": "多区域共轭传热 + 映射温度界面 BC",
    "applicability": "液体冷却板、换热器壁等壁温由两侧热通量共同决定。单固体边界已知时可另用适配的导热入口。",
    "exclusions": "固定温度边界是输入，本卡预测的是未直接定值的壁面。接触温差与相变需显式模型。",
    "inputs": [
      "geometry",
      "flow_rate",
      "fluid_properties",
      "inlet_temperature",
      "thermal_boundary",
      "solid_properties",
      "interface_definition",
      "thermal_contact"
    ],
    "exchanges": [
      {
        "from": "fluid_energy",
        "to": "solid_energy",
        "quantity": "温度和热通量",
        "unit": "K; W/m²",
        "method": "热接触完美时求温度连续；可选薄层热阻时两侧温度分开报告。"
      },
      {
        "from": "wall_field",
        "to": "wall_temperature",
        "quantity": "所需壁面温度",
        "unit": "K",
        "method": "按指定表面与时刻读取局部峰值、面积加权平均及温度分布。"
      }
    ],
    "rationale": "冷却侧流动与壁内导热均会影响局部峰温，需界面成对耦合。",
    "custom_work": "源项或映射前先确认热斑位置与界面面组。thermal_contact 可声明理想接触或给定热阻。",
    "checks": [
      "网格加密检查壁温峰值、面平均和界面热量闭合；共轭两侧应按同一法向监视。",
      "完美接触时温度相容；有热阻时温降与热通量一致。"
    ],
    "evidence": [
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/heatTransfer/chtMultiRegionFoam/chtMultiRegionFoam.C",
