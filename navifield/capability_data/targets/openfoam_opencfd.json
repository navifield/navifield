[
  {
    "solver": "openfoam_opencfd",
    "version": "v2606",
    "target": "pressure_drop",
    "role": "configured",
    "model": "simpleFoam 层流或 RANS 内流 + surfaceFieldValue 测站",
    "applicability": "稳态不可压单相内流。充分发展且目标为沿程损失可先核查 Darcy；显著分离可用 SST 并按壁解析分离要求给网格。",
    "exclusions": "不可直接套至相变、多孔替代几何、跨声速或显著非稳态。粗糙管需实测等效粗糙度与相容壁函数。",
    "inputs": [
      "geometry",
      "flow_rate",
      "fluid_properties",
      "pressure_stations",
      "flow_regime",
      "wall_treatment",
      "roughness"
    ],
    "exchanges": [
      {
        "from": "flow_solution",
        "to": "pressure_stations",
        "quantity": "物理静压与速度",
        "unit": "Pa; m/s",
        "method": "按 simpleFoam 的运动学压力乘常密度换算 Pa；沿截面取和工程测量一致的压力平均。"
      },
      {
        "from": "pressure_stations",
        "to": "pressure_drop",
        "quantity": "上游减下游的静压差或总压损失",
        "unit": "Pa",
        "method": "无重力变高时不可压总压 p+ρ|U|²/2；先进测站后按相同声明权重减，标高变化按能量式单列。"
      }
    ],
    "rationale": "从求解器压力基准到工程 Δp 明确同一截面、基准与动压权重。",
    "custom_work": "用原生测站平均与后处理构造总压，无需修改 CFD 方程。",
    "checks": [
      "统一两测站、压力单位、面积/质量权重以及参考标高；确定是否报告静压差或总压损失。",
      "检查质量守恒、网格和非稳态统计；规整光滑管可用解析或 Darcy 摩阻，分离几何另验证。"
    ],
    "evidence": [
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/incompressible/simpleFoam/simpleFoam.C",
        "locator": "applications/solvers/incompressible/simpleFoam/simpleFoam.C；Description 与 createFields",
        "claim": "稳态不可压内流入口。"
      },
      {
        "url": "https://api.openfoam.com/2606/classFoam_1_1functionObjects_1_1fieldValues_1_1surfaceFieldValue.html",
        "locator": "Area operations and weighting",
        "claim": "可面积加权平均、积分和面对面通量代数和。"
      }
    ],
    "conditions": {
      "flow_domain": [
        "free_fluid"
      ],
      "flow_phase": [
        "single_phase"
      ],
      "compressibility": [
        "incompressible"
      ],
      "operation": [
        "steady"
      ],
      "pressure_definition": [
        "static_difference",
        "total_loss"
      ]
    },
    "mechanisms": [
      "flow"
    ],
    "related_capabilities": [
      "openfoam_opencfd.steady_incompressible"
    ],
    "extra_inputs": {
      "operation=transient": [
        "time_history"
      ]
    },
    "variants": [
      {
