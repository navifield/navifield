  {
    "solver": "openfoam_opencfd",
    "version": "v2606",
    "target": "thermal_stress",
    "role": "configured",
    "model": "solidDisplacementFoam / solidEquilibriumDisplacementFoam 小应变热弹性",
    "applicability": "已知温度历史或热边界，线弹性小应变，采用共同常量应力自由参考温度及与温标平移相容的扩散材料。可做 CHT→固体单向。",
    "exclusions": "不得把绝对温度直接视作应力自由温差；不同部件独立参考场、非线性材料与依赖绝对温度的辐射不在此简化映射范围。",
    "inputs": [
      "structural_geometry",
      "temperature_reference",
      "mechanical_constraints",
      "elastic_properties",
      "expansion_coefficient",
      "thermal_boundary",
      "solid_properties",
      "temperature_field"
    ],
    "exchanges": [
      {
        "from": "thermal_solution",
        "to": "solid_mechanics",
        "quantity": "固体温度与应力自由参考态",
        "unit": "K",
        "method": "预处理使输入、初始场和温度边界一致采用 θ=T−T_ref；原生耦合热扩散在求结构时继续演进。独立 CHT 结果需校对映射和目标时刻。"
      },
      {
        "from": "solid_mechanics",
        "to": "stress_report",
        "quantity": "Cauchy 应力、主应力或 von Mises 按工程判据",
        "unit": "Pa",
        "method": "按约定应力不变量、材料和部位回读，附约束反力。"
      }
    ],
    "rationale": "热应力由热膨胀受限和温度梯度共同形成。源码采用零点温度项，必须先对齐参考态。",
    "custom_work": "依温差字段运行，确认固体热解不会覆盖 CHT 的目标工况；若需强耦合接触、任意外部温度时序回放或温度依赖材料，需另选实现/验证。",
    "checks": [
      "均温自由膨胀：移除刚体模后应力趋零；轴向受限且侧向自由杆按 −EαΔT 检查。",
      "复核应力自由温度、温标、材料与边界映射，检查反力平衡与网格敏感性；约束角点奇异峰值单独处理。",
      "若采用 steady solver，确认力残差与热解均已达到稳态；若温度/荷载瞬变，检查热/力时间步。"
    ],
    "evidence": [
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/stressAnalysis/solidDisplacementFoam/calculateStress.H",
        "locator": "applications/solvers/stressAnalysis/solidDisplacementFoam/calculateStress.H；1–35；readThermalProperties.H、solidDisplacementFoam.C:80–103",
        "claim": "直接扣 Iρ·threeKalpha·T，输出 sigma 与 von Mises，读热物性未见内置 T_ref。"
      },
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/stressAnalysis/solidEquilibriumDisplacementFoam/solidEquilibriumDisplacementFoam.C",
        "locator": "applications/solvers/stressAnalysis/solidEquilibriumDisplacementFoam/solidEquilibriumDisplacementFoam.C；Description",
        "claim": "稳态有限体积小应变线弹性，支持热扩散和热应力。"
      }
    ],
    "conditions": {
      "operation": [
        "steady",
        "transient"
      ],
      "mechanics": [
        "linear_elastic"
      ],
      "coupling": [
        "one_way"
      ]
    },
    "mechanisms": [
      "conduction",
      "thermal_expansion",
      "elasticity"
    ],
    "related_capabilities": [
      "openfoam_opencfd.small_strain_thermoelastic"
    ],
    "extra_inputs": {
      "operation=transient": [
        "time_history"
      ]
    }
  }
]
