  {
    "solver": "openfoam_opencfd",
    "version": "v2606",
    "target": "heat_duty",
    "role": "configured",
    "model": "chtMultiRegionSimpleFoam / chtMultiRegionFoam + wallHeatFlux",
    "applicability": "单相流固共轭换热；热边界平衡稳态用 SIMPLE，负荷或热容时变用瞬态。",
    "exclusions": "相变、未施加接触热阻及未知非凝气闭合另评估；热侧与冷侧的同一能流不应双计。",
    "inputs": [
      "geometry",
      "flow_rate",
      "fluid_properties",
      "inlet_temperature",
      "thermal_boundary",
      "solid_properties",
      "interface_definition"
    ],
    "exchanges": [
      {
        "from": "fluid_energy",
        "to": "solid_energy",
        "quantity": "界面两侧温度和法向热流密度",
        "unit": "K; W/m²",
        "method": "多区域温度和导热/对流迭代，wallHeatFlux 后对选定面做 areaIntegrate；另算 m_dot Δh。"
      },
      {
        "from": "wall_or_control_surface",
        "to": "heat_duty",
        "quantity": "净换热率",
        "unit": "W",
        "method": "积分一侧有符号热流，或对各流面作守恒焓流积分。"
      }
    ],
    "rationale": "换热能力依据热流或焓收支，其单位为 W。",
    "custom_work": "设定流固配对与守恒读回面。若界面有层热阻必须提供 thermal_contact 参数。",
    "checks": [
      "壁面积分热率和流体控制体焓流差对照，瞬态加储热，辐射或体热源单列。",
      "热负荷量纲 W；对时程积分得 J。"
    ],
    "evidence": [
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/heatTransfer/chtMultiRegionFoam/chtMultiRegionFoam.C",
        "locator": "applications/solvers/heatTransfer/chtMultiRegionFoam/chtMultiRegionFoam.C；Description；fluid/EEqn.H、solid/solveSolid.H",
        "claim": "热流体与固体区域共轭传热；该路径为瞬态。"
      },
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/heatTransfer/chtMultiRegionFoam/chtMultiRegionSimpleFoam/chtMultiRegionSimpleFoam.C",
        "locator": "applications/solvers/heatTransfer/chtMultiRegionFoam/chtMultiRegionSimpleFoam/chtMultiRegionSimpleFoam.C；Description",
        "claim": "稳态多区域流固换热。"
      },
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/src/thermoTools/derivedFvPatchFields/turbulentTemperatureCoupledBaffleMixed/turbulentTemperatureCoupledBaffleMixedFvPatchScalarField.H",
        "locator": "src/thermoTools/derivedFvPatchFields/turbulentTemperatureCoupledBaffleMixed/turbulentTemperatureCoupledBaffleMixedFvPatchScalarField.H；31–56",
        "claim": "按邻域温度与 KΔ 配重，支持显式指定薄层厚度与热导率。"
      },
      {
        "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/src/functionObjects/field/wallHeatFlux/wallHeatFlux.cxx",
        "locator": "src/functionObjects/field/wallHeatFlux/wallHeatFlux.cxx；calculate()/write()",
        "claim": "根据能量输运或指定模型回读壁面热流。"
      },
      {
        "url": "https://api.openfoam.com/2606/classFoam_1_1functionObjects_1_1fieldValues_1_1surfaceFieldValue.html",
        "locator": "Area operations and weighting",
        "claim": "可面积加权平均、积分和面对面通量代数和。"
      }
    ],
    "conditions": {
      "flow_domain": [
        "free_fluid"
      ],
      "flow_phase": [
        "single_phase"
      ],
      "operation": [
        "steady",
        "transient"
      ],
      "thermal_mode": [
        "conjugate"
      ],
      "phase_change": [
        "none"
      ],
      "coupling": [
        "two_way"
