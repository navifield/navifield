        "version": "v2606",
        "target": "pressure_drop",
        "role": "configured",
        "model": "porousSimpleFoam Darcy–Forchheimer 阻力",
        "applicability": "固定网格阻力区，已标定黏性、惯性阻力和方向，可预测区域宏观压损。",
        "exclusions": "孔尺度射流、局部分离和气液两相需其他模型。",
        "inputs": [
          "geometry",
          "flow_rate",
          "fluid_properties",
          "pressure_stations",
          "porous_resistance"
        ],
        "exchanges": [
          {
            "from": "多孔区动量平衡",
            "to": "压力读回",
            "quantity": "压力与表观速度",
            "unit": "Pa, m/s",
            "method": "按规定的测点或截面取静压差，注明静水项和使用表观速度的面积。"
          }
        ],
        "rationale": "依据材料阻力与通量的关系选模型，核对面积基准、重力水头及测点压力。",
        "custom_work": "测定介质渗透参数及各向异性；拟合的工况范围及独立压降数据需要单列。",
        "checks": [
          "检查流量质量守恒、测压口位置与静水头，分别核对多个流量点。"
        ],
        "evidence": [
          {
            "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/incompressible/simpleFoam/porousSimpleFoam/porousSimpleFoam.C",
            "locator": "steady_incompressible_porous_pressure_loss",
            "claim": "Fixed v2606 application description and solver loop. createPorousZones is invoked by the solver. UEqn/pEqn incorporate porous momentum resistance."
          },
          {
            "url": "https://gitlab.com/openfoam/core/openfoam/-/blob/OpenFOAM-v2606/applications/solvers/incompressible/simpleFoam/porousSimpleFoam/UEqn.H",
            "locator": "steady_incompressible_porous_pressure_loss",
            "claim": "Fixed v2606 field construction or assembled equation for this application."
          }
        ],
        "conditions": {
          "flow_domain": [
            "porous"
          ],
          "flow_phase": [
            "single_phase"
          ],
          "operation": [
            "steady"
          ],
          "pressure_definition": [
            "static_difference"
          ]
        },
        "mechanisms": [
          "flow",
          "darcy"
        ],
        "related_capabilities": [
          "openfoam_opencfd.steady_incompressible_porous_pressure_loss"
        ],
        "extra_inputs": {
          "operation=transient": [
            "time_history"
          ]
        }
      }
    ]
