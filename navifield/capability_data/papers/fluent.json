    "source_url": "https://www.mdpi.com/1996-1073/17/14/3504",
    "source_locator": "摘要；§2.3 图2–3；§2.4 图4–5；§4 图16/表3；Data Availability Statement",
    "conditions": [
      "磷酸铁锂电池包基线放电 1C、1.5C、2C",
      "模拟入口空气 2 m/s、298.15 K，出口为压力边界"
    ],
    "model_chain": [
      "简化电池包内部结构，建立实体电芯、箱体和空气域",
      "压力基瞬态 SIMPLEC，二阶迎风，S2S 辐射及流固表面耦合换热",
      "用 DS18B20 监测台架电芯温度，再用优化样机检验风道与变速风扇控制"
    ],
    "required_inputs": [
      "电芯、箱体与空气通道实体几何",
      "各材料热物性及表面发射率",
      "放电倍率与发热模型、入口风速和温度",
      "温度测点坐标、风扇转速策略和环境温度",
      "传感器至电芯及表面位置、采样时刻和放电状态，以及完整测量不确定度",
      "入口截面积/风机曲线与实验实测流量；电芯各向异性热物性与界面热阻",
      "每个倍率的体积发热率或独立的电流、电压、开路电压和熵热数据"
    ],
    "observations": [
      {
        "kind": "measured",
        "quantity": "电池包基线温度",
        "detail": "作者台架使用 DS18B20 温度传感器，精度 ±0.5 K。",
        "locator": "§2.4 图4–5"
      },
      {
        "kind": "comparison",
        "quantity": "电芯温度",
        "detail": "三种放电倍率下，作者报告测点温度对照误差为 1.5–2.72 K。",
        "locator": "§2.4 图5"
      },
      {
        "kind": "simulated",
        "quantity": "温度分布",
        "detail": "2C 时各电芯温度范围为 305.28–317.30 K。",
        "locator": "§2.3 图2–3"
      },
      {
        "kind": "derived",
        "quantity": "包间最高温差",
        "detail": "对作者台架温度数据计算，优化前不同包的最高温度差可达 7 K，优化后报告为 3.33 K。",
        "locator": "§4 图16、表3"
      }
    ],
    "limitations": [
