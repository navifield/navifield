[
  {
    "id": "fluent-orc-recuperator-2026",
    "doi": "10.3390/en19184278",
    "title": "Domain-Reduced CFD of a Brazed-Plate Recuperator for Organic Rankine Cycles: Validation and Heat-Transfer Correlations",
    "authors": "Saverio Ottaviano, Filippo Monaco, Andrea De Pascale",
    "year": 2026,
    "software_version": "2024 R1",
    "industry": "工业余热回收与有机朗肯循环",
    "targets": [
      "temperature",
      "heat_rate",
      "pressure_drop",
      "heat_transfer_coefficient"
    ],
    "source_url": "https://www.mdpi.com/1996-1073/19/18/4278",
    "source_locator": "§2 图1/表1；§3.1–3.2；§4.1–4.4；§5.1 图12/表6；§5.2 表7；Data Availability Statement",
    "conditions": [
      "16板 ONDA S202，R134a 热侧蒸气、冷侧液体",
      "五个稳态工况，整机质量流量 0.08–0.22 kg/s，Re 约 500–18,500"
    ],
    "model_chain": [
      "从整机提取一对冷热侧波纹流道与其间传热板，沿轴向截取充分发展段并使用纵向对称",
      "使用 Fluent Meshing 生成多面体与近壁棱柱网格，约449万单元",
      "各侧质量流量入口和压力出口，外壁绝热，稳态压力基 coupled，SST k–ω",
      "用 ε–NTU 和压损重建把整机端口值映射至计算段；使用局部换热系数拟合单相 Nu 相关式"
    ],
    "required_inputs": [
      "冷热流道与隔板几何、材料及波纹参数",
      "实测冷热端温度、绝对压力、整机质量流量",
      "通道数及对称缩放，端口局部损失关联式",
      "R134a 热物性及测量不确定度"
    ],
    "observations": [
      {
        "kind": "measured",
        "quantity": "整机端口温度、压力及质量流量",
        "detail": "作者在博洛尼亚大学微型 ORC 台架测得；热电偶标称 ±0.5 °C，热侧与冷侧压力传感器分别 ±0.025 和 ±0.075 bar。",
        "locator": "§2 图1"
      },
      {
        "kind": "derived",
        "quantity": "heat_rate",
        "detail": "由整机质量流量和温变构造换热功率基准，再按有效度换算至缩减域；计算段以侧别温变比较，1–10% 是温变误差。",
        "locator": "§3.1，§5.1 表 6"
      },
      {
        "kind": "derived",
        "quantity": "缩减域温差与通道压降基准",
        "detail": "温差由 ε–NTU 从整机实测端口状态映射；总压降扣除相关式估计的局损，再按线性轴向分布分配至模型段。",
        "locator": "§3.1–3.2"
      },
      {
        "kind": "comparison",
        "quantity": "冷热侧温变与进口压力",
        "detail": "五个工况温变误差约 1–10%，热侧绝对进口压力与派生基准误差低于1%。",
        "locator": "§5.1 表6、图12"
      },
      {
        "kind": "simulated",
        "quantity": "局部温度、压力和流速",
        "detail": "对应第四个试验工况的场量图出自 CFD。",
        "locator": "§5.1 图9–11"
      }
    ],
    "limitations": [
      "冷侧通道压降低于传感器不确定度，尚未验证",
      "波纹节距和人字角由文献估算；局部场缺少实测对照",
      "原始数据按需向通讯作者索取，未见可直接下载的完整 Fluent 工程"
    ],
    "provenance": "出版商开放原始研究，页面刊载日期 2026-09-09，早于工作区 2026-11-20。整机台架为作者团队实验。",
    "software": "Fluent"
  },
  {
    "id": "fluent-lfp-pack-air-cooling-2024",
    "doi": "10.3390/en17143504",
    "title": "Research on the Design of a MIMO Management System for Lithium-Ion Batteries Based on Radiation–Conductivity–Convection Coupled Thermal Analysis",
    "authors": "Qian Wang, Linbin Yan, Lushi Yang, Jianxiao Wang",
    "year": 2024,
    "software_version": "2022 R1",
    "industry": "储能电池热管理",
    "targets": [
      "temperature",
